# Copy to .env and adjust. Never put the Taiga token here: it is asked for on every upload.

# Taiga project link (the URL you see in the browser on the project page)
TAIGA_PROJECT_URL=https://taiga.example.com/project/my-project

# Point value given to every story (name in the project's point scale). Empty = no points.
TAIGA_POINTS=21

# Folder with the story .md files, relative to the repository root
STORIES_DIR=stories
